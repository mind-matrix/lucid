---
import Base from "../layouts/Base.astro";
import styles from "./components.module.css";
import { MousePointerClick, Ban } from "lucide";
import { iconToSvg } from "../lib/icon";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base
  title="Components — Lucid"
  description="Live examples of every component shipped by Lucid."
>
  <div class={styles.pageHeader}>
    <h1>Components</h1>
    <p class={styles.pageHeaderLede}>
      Every component ships as a native custom element. Click a tab to see
      variants, states, and how to invoke it.
    </p>
  </div>

  <lucid-tabs label="Components" value="button" orientation="vertical">
    <lucid-tab slot="tab" value="button">Button</lucid-tab>
    <lucid-tab slot="tab" value="card">Card</lucid-tab>
    <lucid-tab slot="tab" value="select">Select</lucid-tab>
    <lucid-tab slot="tab" value="nav">Nav</lucid-tab>
    <lucid-tab slot="tab" value="tabs">Tabs</lucid-tab>

    <!-- Button -->
    <lucid-tab-panel value="button" class={styles.prose}>
      <h2>Variants</h2>
      <div class={styles.demoRow}>
        <lucid-button>Default</lucid-button>
        <lucid-button variant="primary">Primary</lucid-button>
        <lucid-button variant="ghost">Ghost</lucid-button>
      </div>

      <h2>States</h2>
      <div class={styles.demoRow}>
        <lucid-button variant="primary" disabled>Disabled</lucid-button>
        <lucid-button variant="primary" aria-label="Close dialog">×</lucid-button>
      </div>

      <h2>As a link (polymorphic)</h2>
      <div class={styles.demoRow}>
        <lucid-button variant="ghost" href={`${base}/docs`}>In-app link</lucid-button>
        <lucid-button
          variant="ghost"
          href="https://example.com"
          target="_blank"
        >
          External link
        </lucid-button>
      </div>

      <pre class={styles.proseCode}>{`<lucid-button variant="primary">Save</lucid-button>
<lucid-button variant="ghost" href="/docs">Docs</lucid-button>`}</pre>
    </lucid-tab-panel>

    <!-- Card -->
    <lucid-tab-panel value="card" class={styles.prose}>
      <h2>Variants</h2>
      <div class={styles.demoGrid}>
        <lucid-card>
          <h3 slot="title">Default</h3>
          <p>Outlined with a thin border. Great inside another elevated container.</p>
        </lucid-card>
        <lucid-card variant="filled">
          <h3 slot="title">Filled</h3>
          <p>Subtle tinted background. Use for grouped groups of content.</p>
        </lucid-card>
        <lucid-card variant="elevated">
          <h3 slot="title">Elevated</h3>
          <p>Raised with a soft shadow. Best on plain page backgrounds.</p>
        </lucid-card>
      </div>

      <h2>Clickable (interactive)</h2>
      <div class={styles.demoGrid}>
        <lucid-card clickable variant="elevated">
          <div slot="icon" aria-hidden="true" set:html={iconToSvg(MousePointerClick)} />
          <h3 slot="title">Tab-select this card</h3>
          <p>Focusable via Tab. Enter or Space activates.</p>
        </lucid-card>
        <lucid-card clickable disabled variant="elevated">
          <div slot="icon" aria-hidden="true" set:html={iconToSvg(Ban)} />
          <h3 slot="title">Disabled</h3>
          <p>Focusable via aria-disabled, but click is suppressed.</p>
        </lucid-card>
      </div>

      <pre class={styles.proseCode}>{`<lucid-card variant="elevated" clickable>
  <div slot="icon" aria-hidden="true">◇</div>
  <h3 slot="title">Card title</h3>
  <p>Card body content.</p>
</lucid-card>`}</pre>
    </lucid-tab-panel>

    <!-- Select -->
    <lucid-tab-panel value="select" class={styles.prose}>
      <h2>Basic</h2>
      <p>
        A single-select dropdown following the ARIA select-only combobox
        pattern. Options are slotted, so they take any inline content.
      </p>
      <div class={styles.demoRow}>
        <lucid-select label="Framework" data-demo="basic">
          <lucid-option value="astro">Astro</lucid-option>
          <lucid-option value="react">React</lucid-option>
          <lucid-option value="svelte">Svelte</lucid-option>
          <lucid-option value="vue">Vue</lucid-option>
        </lucid-select>
      </div>

      <h2>Preselected and custom placeholder</h2>
      <div class={styles.demoRow}>
        <lucid-select label="Runtime" value="bun">
          <lucid-option value="bun">Bun</lucid-option>
          <lucid-option value="deno">Deno</lucid-option>
          <lucid-option value="node">Node</lucid-option>
        </lucid-select>
        <lucid-select label="Region" placeholder="Choose a region…">
          <lucid-option value="us-east-1">us-east-1</lucid-option>
          <lucid-option value="eu-west-1">eu-west-1</lucid-option>
          <lucid-option value="ap-south-1">ap-south-1</lucid-option>
        </lucid-select>
      </div>

      <h2>Disabled option, and disabled select</h2>
      <div class={styles.demoRow}>
        <lucid-select label="Tier">
          <lucid-option value="free">Free</lucid-option>
          <lucid-option value="pro" disabled>Pro (coming soon)</lucid-option>
          <lucid-option value="team">Team</lucid-option>
        </lucid-select>
        <lucid-select label="Locked" value="one" disabled>
          <lucid-option value="one">Not editable</lucid-option>
          <lucid-option value="two">Two</lucid-option>
        </lucid-select>
      </div>

      <h2>In a form</h2>
      <p>
        Give it a <code>name</code> and it behaves like a native
        <code>&lt;select&gt;</code>: it submits, shows up in
        <code>FormData</code>, resets with the form, restores on session
        restore, and is switched off by an ancestor
        <code>&lt;fieldset disabled&gt;</code>. Add <code>required</code> and
        it participates in constraint validation, so submitting an empty one
        is blocked and the browser shows its own message.
      </p>
      <div class={styles.demoBlock}>
        <form id="plan-form" class={styles.demoRow}>
          <lucid-select label="Plan" name="plan" required>
            <lucid-option value="hobby">Hobby</lucid-option>
            <lucid-option value="pro">Pro</lucid-option>
            <lucid-option value="enterprise">Enterprise</lucid-option>
          </lucid-select>
          <lucid-button variant="primary" data-action="submit">Submit</lucid-button>
          <lucid-button variant="ghost" data-action="reset">Reset</lucid-button>
        </form>
        <output id="plan-result" class={styles.demoOutput}></output>
      </div>
      <p>
        Submit with nothing selected and the browser blocks it and shows its
        own message. The buttons above call <code>requestSubmit()</code> and
        <code>reset()</code> explicitly because
        <code>&lt;lucid-button&gt;</code> is not form-associated yet — its
        native <code>&lt;button&gt;</code> lives in a shadow root, so
        <code>type="submit"</code> on it would do nothing.
      </p>
      <pre class={styles.proseCode}>{`<form>
  <lucid-select label="Plan" name="plan" required>
    <lucid-option value="hobby">Hobby</lucid-option>
    <lucid-option value="pro">Pro</lucid-option>
  </lucid-select>
</form>`}</pre>
      <pre class={styles.proseCode}>{`const select = document.querySelector("lucid-select");

select.form;               // the owning <form>, or null
select.willValidate;       // true
select.validity.valueMissing;
select.validationMessage;  // "Please select an option."
select.checkValidity();    // false while empty
select.reportValidity();   // …and shows the browser's message

// Localise the message — it is internal chrome, so it cannot be slotted.
select.setAttribute("data-value-missing-message", "Choisissez une option.");`}</pre>

      <h2>Keyboard</h2>
      <ul>
        <li>
          <strong>Closed:</strong> <code>Enter</code>, <code>Space</code>,
          <code>↑</code>, <code>↓</code> open the listbox.
          <code>Home</code>/<code>End</code> open and jump to the first/last
          option. Typing a character opens and jumps to the first match.
        </li>
        <li>
          <strong>Open:</strong> <code>↑</code>/<code>↓</code> move the
          highlight (wrapping, skipping disabled options),
          <code>Home</code>/<code>End</code> jump to the ends,
          <code>Enter</code>/<code>Space</code> commit,
          <code>Esc</code> closes without changing the value,
          <code>Tab</code> commits and moves focus on.
        </li>
      </ul>
      <p>
        Focus stays on the combobox the whole time — options are never
        focusable. The highlighted option is announced via
        <code>aria-activedescendant</code>.
      </p>

      <h2>Reading the value</h2>
      <pre class={styles.proseCode}>{`<lucid-select label="Framework" value="astro">
  <lucid-option value="astro">Astro</lucid-option>
  <lucid-option value="react">React</lucid-option>
  <lucid-option value="vue" disabled>Vue</lucid-option>
</lucid-select>`}</pre>
      <pre class={styles.proseCode}>{`const select = document.querySelector("lucid-select");

// Current value, and the matching <lucid-option> element.
select.value;            // "astro"
select.selectedOption;   // <lucid-option value="astro">

// Imperative open/close.
select.show();
select.hide();
select.toggle();

// Fires on every selection change.
select.addEventListener("lucid-value-change", (e) => {
  console.log(e.detail.value);
});`}</pre>

      <h2>Notes</h2>
      <ul>
        <li>
          The popup renders in the top layer via the Popover API so no other 
          element can clip or bury it. It displays above the trigger when there isn't
          room below, and shrinks to fit within the screen boundary.
        </li>
        <li>
          <code>lucid-value-change</code> fires for user-driven changes only.
          Assigning <code>.value</code> in code updates everything but stays
          silent, matching native <code>&lt;select&gt;</code>.
        </li>
      </ul>
    </lucid-tab-panel>

    <!-- Nav -->
    <lucid-tab-panel value="nav" class={styles.prose}>
      <h2>Horizontal</h2>
      <div class={styles.demoBlock}>
        <lucid-nav label="Example horizontal">
          <lucid-nav-link href="#" active>Home</lucid-nav-link>
          <lucid-nav-link href="#">Docs</lucid-nav-link>
          <lucid-nav-link href="#">Components</lucid-nav-link>
          <lucid-nav-link href="#" disabled>Coming Soon</lucid-nav-link>
        </lucid-nav>
      </div>

      <h2>Vertical (sidebar-style)</h2>
      <div class={styles.demoBlock}>
        <lucid-nav orientation="vertical" label="Example vertical">
          <lucid-nav-link href="#">Getting Started</lucid-nav-link>
          <lucid-nav-link href="#" active>Components</lucid-nav-link>
          <lucid-nav-link href="#">Tokens</lucid-nav-link>
        </lucid-nav>
      </div>

      <pre class={styles.proseCode}>{`<lucid-nav label="Primary">
  <lucid-nav-link href="/">Home</lucid-nav-link>
  <lucid-nav-link href="/docs" active>Docs</lucid-nav-link>
</lucid-nav>`}</pre>
    </lucid-tab-panel>

    <!-- Tabs -->
    <lucid-tab-panel value="tabs" class={styles.prose}>
      <h2>Automatic activation (default)</h2>
      <p>Arrow keys move focus and select. Fastest UX for cheap panels.</p>
      <div class={styles.demoBlock}>
        <lucid-tabs label="Example automatic" value="one">
          <lucid-tab slot="tab" value="one">One</lucid-tab>
          <lucid-tab slot="tab" value="two">Two</lucid-tab>
          <lucid-tab slot="tab" value="three">Three</lucid-tab>
          <lucid-tab-panel value="one">Panel one</lucid-tab-panel>
          <lucid-tab-panel value="two">Panel two</lucid-tab-panel>
          <lucid-tab-panel value="three">Panel three</lucid-tab-panel>
        </lucid-tabs>
      </div>

      <h2>Manual activation</h2>
      <p>Arrow keys move focus only. User presses Enter or Space to select. Better for expensive panels.</p>
      <div class={styles.demoBlock}>
        <lucid-tabs
          label="Example manual"
          activation="manual"
          value="alpha"
        >
          <lucid-tab slot="tab" value="alpha">Alpha</lucid-tab>
          <lucid-tab slot="tab" value="beta">Beta</lucid-tab>
          <lucid-tab-panel value="alpha">Alpha panel</lucid-tab-panel>
          <lucid-tab-panel value="beta">Beta panel</lucid-tab-panel>
        </lucid-tabs>
      </div>

      <pre class={styles.proseCode}>{`<lucid-tabs label="Docs sections" value="intro">
  <lucid-tab slot="tab" value="intro">Introduction</lucid-tab>
  <lucid-tab slot="tab" value="install">Installation</lucid-tab>
  <lucid-tab-panel value="intro">…</lucid-tab-panel>
  <lucid-tab-panel value="install">…</lucid-tab-panel>
</lucid-tabs>`}</pre>
    </lucid-tab-panel>
  </lucid-tabs>
</Base>

<script>
  // Glue for the Select tab's form demo. <lucid-button> is not
  // form-associated — its native <button> sits inside a shadow root, so
  // type="submit" would never reach this form — hence the explicit
  // requestSubmit()/reset() calls.
  const form = document.getElementById("plan-form");
  const result = document.getElementById("plan-result");

  if (form instanceof HTMLFormElement && result) {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      result.textContent = `Submitted → ${[...new FormData(form)]
        .map(([key, value]) => `${key}=${value}`)
        .join("&")}`;
    });

    form.querySelector('[data-action="submit"]')?.addEventListener("click", () => {
      // Runs interactive validation, so an empty required select is blocked
      // and the browser shows its own message.
      form.requestSubmit();
    });

    form.querySelector('[data-action="reset"]')?.addEventListener("click", () => {
      form.reset();
      result.textContent = "";
    });
  }
</script>
